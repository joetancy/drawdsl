# ELK is the default and provides orthogonal, hierarchy-aware routing.
layout elk
direction right

aws:internet internet "Internet"

aws:cloud cloud "AWS Cloud" {
    aws:vpc application_vpc "Application VPC" {
        aws:private_subnet app_subnet "Application subnet" {
            aws:alb public_alb "Public ALB"
            aws:lambda api "API Lambda"
            aws:dynamodb data "Application data"
        }
    }
}

internet --> public_alb
public_alb --> api
api --> data
