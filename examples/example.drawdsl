# Example architecture demonstrating hierarchy-aware routing and connection layers.
direction right
node-spacing 120
edge-spacing 24

color request = #F90
color async = #2563EB
color dataflow = #15803D
color operations = #7C3AED
color platform = #EEF2F7

aws:internet internet "Public internet"
core:image reference_image "https://placehold.co/320x200/png?text=External+image"

aws:cloud cloud "AWS Cloud" {
    aws:region singapore "ap-southeast-1" {
        aws:vpc app_vpc "Application VPC" {
            aws:public_subnet web_subnet "Public subnet" {
                aws:cloudfront cdn "CloudFront"
                aws:alb alb "Application Load Balancer"
                aws:apigateway api "API Gateway"
            }

            aws:private_subnet app_subnet "Application subnet" {
                aws:lambda lambda1 "Orders Lambda"
                aws:lambda lambda2 "Notifications Lambda"
                aws:dynamodb data "Orders DynamoDB"
                aws:sqs queue "Job queue"
                core:text app_note "Private application workloads"
            }
        }

        aws:vpc data_vpc "Data VPC" {
            aws:private_subnet data_subnet "Data subnet" {
                aws:rds database "Reporting database"
                aws:s3 bucket "Archive bucket"
            }
        }

        core:group operations_group "Operations" [background=platform] {
            col 2
            aws:sns topic "Deployment notifications"
            aws:cloudwatch_2 monitoring "Monitoring"
            core:text ops_note "Shared platform services"
        }
    }
}

# Unassigned edges belong to the implicit Connections layer.
internet --> cdn : DNS / HTTPS

# Request path: layer defaults style the complete synchronous flow.
# Endpoint selectors and a chained edge are both supported inside a layer.
layer requests "Request flow" [color=request, width=2] {
    cdn -.-> alb : cached requests
    R:alb --> L:api --> lambda1
}

# Data flow starts visible and reuses shared nodes from the request flow.
# The DynamoDB-to-database edge overrides the layer width.
layer persistence "Persistence flow" [color=dataflow, width=2] {
    lambda1 <--> data : reads and writes
    data --> database [width=3] : replicates
    lambda1 --> bucket : archives
}

# Async processing starts hidden but is still laid out and routed with all other edges.
layer async_jobs "Async jobs" [color=async, width=2, visible=false] {
    lambda1 -.- lambda2 : peer handoff
    lambda2 <-.-> queue : async jobs
}

# An edge may reference a layer before the layer declaration.
topic --> lambda2 [layer=operations] : notifications

layer operations "Operations flow" [color=operations, visible=false] {
    monitoring --- api : observes
    ops_note -.- app_note : runbook
}
