# Dagre is a compact layered-layout alternative to ELK.
layout dagre
direction right

aws:internet internet "Public internet"
core:image reference_image "https://placehold.co/320x200/png?text=External+image"

aws:cloud cloud "AWS Cloud" {
    aws:region singapore "ap-southeast-1" {
        aws:vpc app_vpc "Application VPC" {
            aws:public_subnet web_subnet "Public subnet" {
                aws:cloudfront cdn "CloudFront"
                aws:alb alb "Application Load Balancer"
                aws:apigateway api "API Gateway"
            }

            aws:private_subnet app_subnet "Application subnet" {
                aws:lambda lambda1 "Orders Lambda"
                aws:lambda lambda2 "Notifications Lambda"
                aws:dynamodb data "Orders DynamoDB"
                aws:sqs queue "Job queue"
                core:text app_note "Private application workloads"
            }
        }

        aws:vpc data_vpc "Data VPC" {
            aws:private_subnet data_subnet "Data subnet" {
                aws:rds database "Reporting database"
                aws:s3 bucket "Archive bucket"
            }
        }

        core:group operations "Operations" {
            aws:sns topic "Deployment notifications"
            aws:cloudwatch_2 monitoring "Monitoring"
            core:text ops_note "Shared platform services"
        }
    }
}

internet --> cdn : HTTPS
cdn -.-> alb : cached requests
alb --> api : forwards
api --- lambda1 : invokes
lambda1 -.- lambda2 : peer handoff
lambda1 <--> data : reads and writes
lambda2 <-.-> queue : async jobs
data --> database : persists
lambda1 --> bucket : archives
topic --> lambda2 : notifications
monitoring --- api : observes
ops_note -.- app_note : runbook
