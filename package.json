{
  "name": "drawdsl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node --import tsx src/drawdsl.ts",
    "lint": "node --import tsx src/drawdsl.ts --check",
    "format": "node --import tsx src/drawdsl.ts --format",
    "format:write": "node --import tsx src/drawdsl.ts --format --write",
    "lint:ts": "eslint \"**/*.ts\"",
    "format:ts": "eslint \"**/*.ts\" --fix",
    "example": "node --import tsx src/drawdsl.ts examples/elk.drawdsl examples/elk.drawio",
    "examples": "npm run example",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:web": "playwright test",
    "bench": "node --import tsx scripts/bench.ts",
    "check": "tsc --noEmit",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "plugin:build": "vite build --config vite.plugin.config.ts"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@mr_mint/elkjs-libavoid": "^0.5.0",
    "codemirror": "^6.0.2",
    "elkjs": "0.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.3"
  }
}
