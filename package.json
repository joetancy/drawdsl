{
  "name": "drawdsl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/drawdsl.ts",
    "lint": "tsx src/drawdsl.ts --check",
    "format": "tsx src/drawdsl.ts --format",
    "format:write": "tsx src/drawdsl.ts --format --write",
    "example": "tsx src/drawdsl.ts examples/aws.drawdsl examples/aws.drawio",
    "example:elk": "tsx src/drawdsl.ts examples/elk.drawdsl examples/elk.drawio",
    "example:dagre": "tsx src/drawdsl.ts examples/dagre.drawdsl examples/dagre.drawio",
    "examples": "npm run example:elk && npm run example:dagre",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "elkjs": "0.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
